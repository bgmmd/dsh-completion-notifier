{
  "name": "@local/completion-notifier",
  "version": "1.0.0",
  "private": true,
  "description": "DeepSeek Harness plugin: plays a chime and shows a Windows toast when a conversation turn completes.",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "notification",
    "windows",
    "toast",
    "sound"
  ],
  "author": "bgmmd",
  "homepage": "https://github.com/bgmmd/dsh-completion-notifier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgmmd/dsh-completion-notifier.git"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "notify-windows.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
